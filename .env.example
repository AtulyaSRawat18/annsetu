# Local PostgreSQL uses the current macOS account over its Unix socket.
DATABASE_URL=dbname=annsetu

# For Supabase/Vercel, use the Supabase shared pooler in transaction mode and
# append ?sslmode=require. Never commit the real connection string.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

# OSM-compatible map tiles. Replace the default before high-volume SaaS use.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
